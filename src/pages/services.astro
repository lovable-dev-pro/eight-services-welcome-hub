---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getPageContent, getServices, getSiteSettings } from "../wix/cms/cms";

export const prerender = false;

const content = await getPageContent("services");
const services = await getServices();
const settings = await getSiteSettings();

const rawPhone = settings.phone.replace(/[^0-9]/g, "");
---

<SiteLayout
  title={`Vehicle Servicing & Repairs | ${settings.businessName} ${settings.businessSubtitle}`}
  description={content.heroDescription}
  currentPath="/services"
>
  <section class="page-heading">
    <div class="site-container">
      <div class="section-kicker">{content.heroEyebrow}</div>
      <h1 class="section-title">{content.heroTitle}</h1>
      <p class="page-hero-description">
        {content.heroDescription}
      </p>
    </div>
  </section>

  <section class="site-container service-list-section">
    <div class="service-list">
      {services.map((service, index) => {
        const textParam = encodeURIComponent(`Hi ${settings.businessName}, I’d like to ask about a ${service.title.toLowerCase()} for my vehicle.`);
        const whatsappHref = `https://wa.me/${rawPhone}?text=${textParam}`;
        return (
          <article class="service-card" id={service.id} key={service.id}>
            <div class="service-card-top">
              <span class="service-number">0{index + 1}</span>
              <span class="service-icon">
                {service.icon === 'droplets' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"></path>
                    <path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"></path>
                  </svg>
                )}
                {service.icon === 'gauge' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 14 4-4"></path>
                    <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
                  </svg>
                )}
                {service.icon === 'circle-gauge' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15.6 2.7a10 10 0 1 0 5.7 5.7"></path>
                    <circle cx="12" cy="12" r="2"></circle>
                    <path d="M13.4 10.6 19 5"></path>
                  </svg>
                )}
                {service.icon === 'wrench' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"></path>
                  </svg>
                )}
                {service.icon === 'settings' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 17H5"></path>
                    <path d="M19 7h-9"></path>
                    <circle cx="17" cy="17" r="3"></circle>
                    <circle cx="7" cy="7" r="3"></circle>
                  </svg>
                )}
                {service.icon === 'battery-charging' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m11 7-3 5h4l-3 5"></path>
                    <path d="M14.856 6H16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.935"></path>
                    <path d="M22 14v-4"></path>
                    <path d="M5.14 18H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h2.936"></path>
                  </svg>
                )}
                {service.icon === 'disc' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <path d="M6 12c0-1.7.7-3.2 1.8-4.2"></path>
                    <circle cx="12" cy="12" r="2"></circle>
                    <path d="M18 12c0 1.7-.7 3.2-1.8 4.2"></path>
                  </svg>
                )}
              </span>
            </div>
            <h2>{service.title}</h2>
            <p class="service-description">{service.description}</p>
            {service.interval && <span class="service-interval">{service.interval}</span>}
            {service.included && service.included.length > 0 && (
              <ul class="service-includes">
                {service.included.map((item) => (
                  <li key={item}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    {item}
                  </li>
                ))}
              </ul>
            )}
            <a class="service-card-link" href={whatsappHref} target="_blank" rel="noreferrer">
              Ask about this service
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </a>
          </article>
        );
      })}
    </div>

    {content.footnote && (
      <p class="service-footnote">
        {content.footnote}
      </p>
    )}
  </section>

  <!-- Service Callout -->
  <section class="service-callout">
    <div>
      <h2>{content.calloutTitle}</h2>
      <p>{content.calloutDescription}</p>
    </div>
    <a href="/contact" class="brand-button callout-button">
      {content.calloutButtonText || "Request a quote"}
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14"></path>
        <path d="m12 5 7 7-7 7"></path>
      </svg>
    </a>
  </section>
</SiteLayout>
